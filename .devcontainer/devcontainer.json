{
  "name": "Boops-Boops Simulator Container",
  "privileged": true,
  "remoteUser": "ros",
  "build": {
    "dockerfile": "../docker/Dockerfile.sim",
    "args": {
      "USERNAME": "ros"
    }
  },
  "workspaceFolder": "/home/ros/Boops-Boops",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/Boops-Boops,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-themes",
        "twxs.cmake",
        "donjayamanne.python-extension-pack",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "containerEnv": {
    "DISPLAY": "unix:0",
    "ROS_LOCALHOST_ONLY": "1",
    "ROS_DOMAIN_ID": "42"
  },
  "runArgs": [
    "--net=host",
    "--ipc=host",
    "--device=/dev/dri",
    "--device=/dev/kfd",
    "-p",
    "5000:5000",
    "-e",
    "DISPLAY=${env:DISPLAY}"
  ],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
  ],
  "postCreateCommand": "sudo apt update && rosdep update --rosdistro=foxy --include-eol-distros && rosdep -i install --from-paths src --rosdistro foxy -y"
}
