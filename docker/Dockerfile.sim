FROM osrf/ros:foxy-desktop
ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Create the user
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && usermod -aG dialout $USERNAME \
    && usermod -aG video $USERNAME \
    && mkdir /home/$USERNAME/.config && chown $USER_UID:$USER_GID /home/$USERNAME/.config \
    #
    # [Optional] Add sudo support. Omit if you don't need to install software after connecting.
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && rm -rf /var/lib/apt/lists/*

# Install miscellaneous dependecies
# psmisc for killall
RUN apt-get update \
    && apt-get install -y psmisc \
    && rm -rf /var/lib/apt/lists/*

# Install Spinnaker SDK
RUN DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y wget \
    && wget "https://flir.netx.net/file/asset/71717/original/attachment" -O spinnaker-4.2.0.88-amd64-20.04-pkg.tar.gz \
    && tar -xzf spinnaker-4.2.0.88-amd64-20.04-pkg.tar.gz \
    && cd spinnaker-4.2.0.88-amd64 \
    # Done so the prompts can be skipped, "yes" to skip yes/no prompts, "ros" to add user to flir group, and "\n" to stop adding users to the flir group
    && { while [ 1 ]; do echo "yes"; echo "ros"; echo "\n"; done; } | sh install_spinnaker.sh \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y python3-pip \
    && rm -rf /var/lib/apt/lists/*

USER $USERNAME

# This is duplicated from requirements.txt because docker can only access files from its build context during the image build step
# TODO: Remove duplication of requirements
RUN pip3 install eventlet "flask-socketio>=5.0.0,<6.0.0" "flask>=3.0.0,<4.0.0" pytailwindcss ultralytics gdown

USER root

# Install updated mesa drivers
# Greatly improves Gazebo performance for systems with newer AMD gpus
# Shouldn't affect other systems and shouldn't change install size too much
# TODO: Run these commands only when host system has AMD gpu / when needed, might need to move out of Dockerfile?
RUN apt-get update \
    && apt-get install -y software-properties-common \
    && add-apt-repository ppa:kisak/turtle \
    && apt-get install -y libgl1-mesa-dri libglx-mesa0 libegl1 libgbm1 mesa-vulkan-drivers mesa-utils \
    && rm -rf /var/lib/apt/lists/*

COPY bashrc /home/${USERNAME}/.bashrc

ENV SHELL /bin/bash

# [Optional] Set the default user. Omit if you want to keep the default as root.
USER $USERNAME
CMD ["/bin/bash"]